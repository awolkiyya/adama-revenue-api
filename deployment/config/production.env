
# ============================================================
# ADAMA MUNICIPAL REVENUE API - PRODUCTION DEPLOYMENT
# ============================================================

APP_ENVIRONMENT="production"

# Application directories
APP_ROOT="/opt/adama-revenue-api"
SOURCE_DIR="/opt/adama-revenue-api/source-production"

# Laravel application environment
ENV_FILE="/opt/adama-revenue-api/.env.production"

# Docker Compose configuration
COMPOSE_PROJECT_NAME="adama-revenue-production"
COMPOSE_FILE="docker/compose.yml"
COMPOSE_OVERRIDE_FILE="docker/compose.production.yml"

# Docker image
APP_IMAGE="adama-revenue-api:production"

# Source archive transferred from GitHub Actions
SOURCE_ARCHIVE="/tmp/laravel-production-source.tar.gz"

# Shared gateway
GATEWAY_COMPOSE_FILE="/opt/adama-revenue-api/gateway/docker/compose.gateway.yml"

# Docker networks
STAGING_NETWORK="adama-revenue-staging_app-network"
PRODUCTION_NETWORK="adama-revenue-production_app-network"

# Docker Compose services
POSTGRES_SERVICE="postgres"
REDIS_SERVICE="redis"
APP_SERVICE="app"
NGINX_SERVICE="nginx"
WORKER_SERVICE="worker"
SCHEDULER_SERVICE="scheduler"

# Database backup policy
DATABASE_BACKUP_REQUIRED="true"

# Production PostgreSQL backup script
DATABASE_BACKUP_SCRIPT="/usr/local/sbin/adama-revenue-production-backup"
