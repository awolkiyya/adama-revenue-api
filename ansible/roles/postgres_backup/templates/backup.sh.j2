#!/usr/bin/env bash

# ==========================================================
# ADAMA MUNICIPAL REVENUE API
# POSTGRESQL BACKUP SCRIPT
# ==========================================================

set -Eeuo pipefail
umask 077

# ----------------------------------------------------------
# CONFIGURATION - GENERATED BY ANSIBLE
# ----------------------------------------------------------

PROJECT_DIR={{ backup_project_dir | quote }}
COMPOSE_PROJECT={{ backup_compose_project | quote }}

COMPOSE_FILE={{ backup_compose_file | quote }}
COMPOSE_OVERRIDE_FILE={{ backup_compose_override_file | quote }}
ENV_FILE={{ backup_env_file | quote }}

POSTGRES_SERVICE={{ backup_postgres_service | quote }}

BACKUP_DIR={{ backup_postgres_dir | quote }}
LOG_FILE={{ backup_log_file | quote }}
LOCK_FILE={{ backup_lock_file | quote }}

RETENTION_DAYS={{ backup_retention_days | int }}
FILE_MODE={{ backup_file_mode | quote }}

BACKUP_PREFIX={{ backup_compose_project | quote }}

# ----------------------------------------------------------
# LOGGING
# ----------------------------------------------------------

if [[ ! -f "$LOG_FILE" ]]; then
    echo "ERROR: Backup log file does not exist: $LOG_FILE" >&2
    exit 1
fi

if [[ ! -w "$LOG_FILE" ]]; then
    echo "ERROR: Backup log file is not writable: $LOG_FILE" >&2
    exit 1
fi

# Preserve standard output for machine-readable results.
#
# Standard output is used by database-migrate.sh to receive:
#   BACKUP_FILE
#   BACKUP_CREATED_AT
#
# Normal backup logs are redirected to LOG_FILE.

exec 3>&1

exec >> "$LOG_FILE" 2>&1

log() {
    printf '[%s] %s\n' \
        "$(date -u '+%Y-%m-%d %H:%M:%S UTC')" \
        "$*"
}

# ----------------------------------------------------------
# TEMPORARY FILES AND CLEANUP
# ----------------------------------------------------------

TEMP_FILE=""
TEMP_CHECKSUM=""
FINAL_FILE=""
FINAL_CHECKSUM=""

cleanup() {
    local exit_code=$?

    if [[ -n "$TEMP_FILE" && -f "$TEMP_FILE" ]]; then
        rm -f -- "$TEMP_FILE"
    fi

    if [[ -n "$TEMP_CHECKSUM" && -f "$TEMP_CHECKSUM" ]]; then
        rm -f -- "$TEMP_CHECKSUM"
    fi

    # Remove an incomplete published backup if checksum
    # publication failed.
    if [[ "$exit_code" -ne 0 && -n "$FINAL_FILE" ]]; then

        if [[ -f "$FINAL_FILE" && ! -f "$FINAL_CHECKSUM" ]]; then
            rm -f -- "$FINAL_FILE"
        fi

    fi

    if [[ "$exit_code" -ne 0 ]]; then
        log "Backup process exited with status: $exit_code"
    fi

    return "$exit_code"
}

trap cleanup EXIT

trap 'log "ERROR: Backup failed near line ${LINENO}."' ERR

# ----------------------------------------------------------
# INITIAL VALIDATION
# ----------------------------------------------------------

log "=========================================================="
log "Starting PostgreSQL backup"
log "Compose project: $COMPOSE_PROJECT"
log "PostgreSQL service: $POSTGRES_SERVICE"
log "Backup directory: $BACKUP_DIR"
log "=========================================================="

for required_file in \
    "$COMPOSE_FILE" \
    "$COMPOSE_OVERRIDE_FILE" \
    "$ENV_FILE"
do

    if [[ ! -f "$required_file" ]]; then
        log "ERROR: Required configuration file does not exist: $required_file"
        exit 1
    fi

done

if [[ ! -d "$PROJECT_DIR" ]]; then
    log "ERROR: Project directory does not exist: $PROJECT_DIR"
    exit 1
fi

if [[ ! -d "$BACKUP_DIR" ]]; then
    log "ERROR: Backup directory does not exist: $BACKUP_DIR"
    exit 1
fi

if [[ ! -w "$BACKUP_DIR" ]]; then
    log "ERROR: Backup directory is not writable: $BACKUP_DIR"
    exit 1
fi

if [[ "$RETENTION_DAYS" -lt 1 ]]; then
    log "ERROR: Retention must be at least one day."
    exit 1
fi

if [[ ! "$FILE_MODE" =~ ^0?[0-7]{3,4}$ ]]; then
    log "ERROR: Invalid backup file permission mode: $FILE_MODE"
    exit 1
fi

# ----------------------------------------------------------
# REQUIRED HOST COMMANDS
# ----------------------------------------------------------

for required_command in \
    docker \
    flock \
    grep \
    mktemp \
    sha256sum \
    awk \
    find \
    chmod \
    mv \
    rm \
    date \
    basename
do

    if ! command -v "$required_command" >/dev/null 2>&1; then
        log "ERROR: Required host command is unavailable: $required_command"
        exit 1
    fi

done

# ----------------------------------------------------------
# DOCKER COMPOSE COMMAND
# ----------------------------------------------------------

COMPOSE=(
    docker compose
    --env-file "$ENV_FILE"
    --project-directory "$PROJECT_DIR"
    -p "$COMPOSE_PROJECT"
    -f "$COMPOSE_FILE"
    -f "$COMPOSE_OVERRIDE_FILE"
)

# ----------------------------------------------------------
# VALIDATE DOCKER COMPOSE
# ----------------------------------------------------------

log "Validating Docker Compose configuration..."

"${COMPOSE[@]}" config -q

log "Docker Compose configuration is valid."

# ----------------------------------------------------------
# PREVENT CONCURRENT BACKUPS
# ----------------------------------------------------------

exec 9>"$LOCK_FILE"

if ! flock -n 9; then
    log "ERROR: Another backup process is already running."
    log "ERROR: This backup request cannot be completed."
    exit 75
fi

log "Backup lock acquired."

# ----------------------------------------------------------
# CHECK POSTGRESQL CONTAINER
# ----------------------------------------------------------

log "Checking PostgreSQL container status..."

RUNNING_SERVICES="$(
    "${COMPOSE[@]}" ps --status running --services
)"

if ! grep -Fxq "$POSTGRES_SERVICE" <<< "$RUNNING_SERVICES"; then
    log "ERROR: PostgreSQL service is not running: $POSTGRES_SERVICE"
    exit 1
fi

log "PostgreSQL container is running."

# ----------------------------------------------------------
# CHECK POSTGRESQL READINESS
# ----------------------------------------------------------

log "Checking PostgreSQL database readiness..."

"${COMPOSE[@]}" exec -T "$POSTGRES_SERVICE" sh -ec '
    : "${POSTGRES_USER:?POSTGRES_USER is not configured}"
    : "${POSTGRES_DB:?POSTGRES_DB is not configured}"

    pg_isready \
        --username="$POSTGRES_USER" \
        --dbname="$POSTGRES_DB"
'

log "PostgreSQL database is accepting connections."

# ----------------------------------------------------------
# GENERATE BACKUP FILENAMES
# ----------------------------------------------------------

TIMESTAMP="$(date -u '+%Y%m%dT%H%M%SZ')"

FINAL_FILE="${BACKUP_DIR}/${BACKUP_PREFIX}_${TIMESTAMP}.dump"
FINAL_CHECKSUM="${FINAL_FILE}.sha256"

if [[ -e "$FINAL_FILE" || -e "$FINAL_CHECKSUM" ]]; then
    log "ERROR: Backup destination already exists."
    exit 1
fi

TEMP_FILE="$(
    mktemp "${BACKUP_DIR}/.${BACKUP_PREFIX}_XXXXXX.tmp"
)"

TEMP_CHECKSUM="${TEMP_FILE}.sha256"

log "Temporary backup file: $TEMP_FILE"

# ----------------------------------------------------------
# CREATE POSTGRESQL BACKUP
# ----------------------------------------------------------

log "Creating PostgreSQL custom-format backup..."

"${COMPOSE[@]}" exec -T "$POSTGRES_SERVICE" sh -ec '
    : "${POSTGRES_USER:?POSTGRES_USER is not configured}"
    : "${POSTGRES_DB:?POSTGRES_DB is not configured}"

    exec pg_dump \
        --username="$POSTGRES_USER" \
        --dbname="$POSTGRES_DB" \
        --format=custom \
        --no-owner \
        --no-acl
' > "$TEMP_FILE"

if [[ ! -s "$TEMP_FILE" ]]; then
    log "ERROR: PostgreSQL backup file is empty."
    exit 1
fi

log "PostgreSQL backup file created successfully."

# ----------------------------------------------------------
# VERIFY BACKUP ARCHIVE
# ----------------------------------------------------------

log "Verifying PostgreSQL backup archive..."

"${COMPOSE[@]}" exec -T "$POSTGRES_SERVICE" \
    pg_restore --list < "$TEMP_FILE" > /dev/null

log "PostgreSQL backup archive verification passed."

# ----------------------------------------------------------
# GENERATE SHA256 CHECKSUM
# ----------------------------------------------------------

log "Generating SHA256 checksum..."

CHECKSUM="$(
    sha256sum "$TEMP_FILE" | awk '{ print $1 }'
)"

if [[ ! "$CHECKSUM" =~ ^[a-fA-F0-9]{64}$ ]]; then
    log "ERROR: Generated SHA256 checksum is invalid."
    exit 1
fi

printf '%s  %s\n' \
    "$CHECKSUM" \
    "$(basename "$FINAL_FILE")" \
    > "$TEMP_CHECKSUM"

# ----------------------------------------------------------
# APPLY FILE PERMISSIONS
# ----------------------------------------------------------

log "Applying secure backup file permissions..."

chmod "$FILE_MODE" "$TEMP_FILE"
chmod "$FILE_MODE" "$TEMP_CHECKSUM"

# ----------------------------------------------------------
# PUBLISH BACKUP
# ------------------------------------------------------------

log "Publishing PostgreSQL backup..."

mv -- "$TEMP_FILE" "$FINAL_FILE"
TEMP_FILE=""

mv -- "$TEMP_CHECKSUM" "$FINAL_CHECKSUM"
TEMP_CHECKSUM=""

log "Backup successfully saved:"
log "$FINAL_FILE"

log "Checksum saved:"
log "$FINAL_CHECKSUM"

# ----------------------------------------------------------
# VERIFY SAVED CHECKSUM
# ----------------------------------------------------------

log "Verifying saved backup checksum..."

(
    cd "$BACKUP_DIR"
    sha256sum --check "$(basename "$FINAL_CHECKSUM")"
)

log "Saved backup checksum verified."

# ----------------------------------------------------------
# CAPTURE BACKUP CREATION TIMESTAMP
# ----------------------------------------------------------

# Capture the timestamp only after:
#   1. The backup archive has been published.
#   2. The checksum has been published.
#   3. The saved checksum has been verified.
#
# The migration script uses this timestamp to verify that
# the backup belongs to the current deployment attempt.

BACKUP_CREATED_AT="$(date +%s)"

if [[ ! "$BACKUP_CREATED_AT" =~ ^[0-9]+$ ]]; then
    log "ERROR: Unable to determine backup creation timestamp."
    exit 1
fi

# ----------------------------------------------------------
# BACKUP RETENTION CLEANUP
# ----------------------------------------------------------

log "Removing backups older than ${RETENTION_DAYS} days..."

while IFS= read -r -d '' OLD_BACKUP; do

    OLD_CHECKSUM="${OLD_BACKUP}.sha256"

    log "Removing expired backup: $OLD_BACKUP"

    rm -f -- "$OLD_BACKUP"

    if [[ -f "$OLD_CHECKSUM" ]]; then
        rm -f -- "$OLD_CHECKSUM"
    fi

done < <(
    find "$BACKUP_DIR" \
        -maxdepth 1 \
        -type f \
        -name "${BACKUP_PREFIX}_*.dump" \
        -mtime "+${RETENTION_DAYS}" \
        -print0
)

log "Backup retention cleanup completed."

# ----------------------------------------------------------
# FINISHED
# ----------------------------------------------------------

log "=========================================================="
log "PostgreSQL backup completed successfully."
log "Backup: $FINAL_FILE"
log "Checksum: $FINAL_CHECKSUM"
log "=========================================================="

# ----------------------------------------------------------
# RETURN MACHINE-READABLE BACKUP RESULT
# ----------------------------------------------------------

# Standard output is reserved for the deployment orchestrator.
# Detailed logs remain in LOG_FILE.
#
# database-migrate.sh expects these exact variable names.

printf 'BACKUP_FILE=%s\n' "$FINAL_FILE" >&3

printf 'BACKUP_CREATED_AT=%s\n' "$BACKUP_CREATED_AT" >&3

exit 0