
#!/usr/bin/env bash

# ==========================================================
# ADAMA MUNICIPAL REVENUE API
# POSTGRESQL BACKUP SCRIPT
# ==========================================================

set -Eeuo pipefail
umask 077

# ----------------------------------------------------------
# CONFIGURATION - GENERATED BY ANSIBLE
# ----------------------------------------------------------

PROJECT_DIR={{ backup_project_dir | quote }}
COMPOSE_PROJECT={{ backup_compose_project | quote }}

COMPOSE_FILE={{ backup_compose_file | quote }}
COMPOSE_OVERRIDE_FILE={{ backup_compose_override_file | quote }}
ENV_FILE={{ backup_env_file | quote }}

POSTGRES_SERVICE={{ backup_postgres_service | quote }}

BACKUP_DIR={{ backup_postgres_dir | quote }}
LOG_FILE={{ backup_log_file | quote }}
LOCK_FILE={{ backup_lock_file | quote }}

RETENTION_DAYS={{ backup_retention_days | int }}
FILE_MODE={{ backup_file_mode | quote }}

BACKUP_PREFIX={{ backup_compose_project | quote }}

# ----------------------------------------------------------
# LOGGING
# ----------------------------------------------------------

if [[ ! -f "$LOG_FILE" ]]; then
    echo "ERROR: Backup log file does not exist: $LOG_FILE" >&2
    exit 1
fi

if [[ ! -w "$LOG_FILE" ]]; then
    echo "ERROR: Backup log file is not writable: $LOG_FILE" >&2
    exit 1
fi

exec >> "$LOG_FILE" 2>&1

log() {
    printf '[%s] %s\n' "$(date -u '+%Y-%m-%d %H:%M:%S UTC')" "$*"
}

# ----------------------------------------------------------
# CLEANUP
# ----------------------------------------------------------

TEMP_FILE=""

cleanup() {
    if [[ -n "$TEMP_FILE" && -f "$TEMP_FILE" ]]; then
        rm -f -- "$TEMP_FILE"
    fi

    if [[ -n "$TEMP_FILE" && -f "${TEMP_FILE}.sha256" ]]; then
        rm -f -- "${TEMP_FILE}.sha256"
    fi
}

trap cleanup EXIT

trap 'log "ERROR: Backup failed near line ${LINENO}."' ERR

# ----------------------------------------------------------
# INITIAL VALIDATION
# ----------------------------------------------------------

log "=========================================================="
log "Starting PostgreSQL backup"
log "Compose project: $COMPOSE_PROJECT"
log "PostgreSQL service: $POSTGRES_SERVICE"
log "Backup directory: $BACKUP_DIR"
log "=========================================================="

for required_file in \
    "$COMPOSE_FILE" \
    "$COMPOSE_OVERRIDE_FILE" \
    "$ENV_FILE"
do
    if [[ ! -f "$required_file" ]]; then
        log "ERROR: Required configuration file does not exist: $required_file"
        exit 1
    fi
done

if [[ ! -d "$PROJECT_DIR" ]]; then
    log "ERROR: Project directory does not exist: $PROJECT_DIR"
    exit 1
fi

if [[ ! -d "$BACKUP_DIR" ]]; then
    log "ERROR: Backup directory does not exist: $BACKUP_DIR"
    exit 1
fi

if [[ ! -w "$BACKUP_DIR" ]]; then
    log "ERROR: Backup directory is not writable: $BACKUP_DIR"
    exit 1
fi

if [[ "$RETENTION_DAYS" -lt 1 ]]; then
    log "ERROR: Retention must be at least one day."
    exit 1
fi

# ----------------------------------------------------------
# DOCKER COMPOSE COMMAND
# ----------------------------------------------------------

COMPOSE=(
    docker compose
    --env-file "$ENV_FILE"
    --project-directory "$PROJECT_DIR"
    -p "$COMPOSE_PROJECT"
    -f "$COMPOSE_FILE"
    -f "$COMPOSE_OVERRIDE_FILE"
)

# ----------------------------------------------------------
# VALIDATE DOCKER COMPOSE
# ----------------------------------------------------------

log "Validating Docker Compose configuration..."

"${COMPOSE[@]}" config -q

log "Docker Compose configuration is valid."

# ----------------------------------------------------------
# PREVENT CONCURRENT BACKUPS
# ----------------------------------------------------------

exec 9>"$LOCK_FILE"

if ! flock -n 9; then
    log "Another backup process is already running. Skipping."
    exit 0
fi

# ----------------------------------------------------------
# CHECK POSTGRESQL CONTAINER
# ----------------------------------------------------------

log "Checking PostgreSQL container status..."

RUNNING_SERVICES="$(
    "${COMPOSE[@]}" ps --status running --services
)"

if ! grep -Fxq "$POSTGRES_SERVICE" <<< "$RUNNING_SERVICES"; then
    log "ERROR: PostgreSQL service is not running: $POSTGRES_SERVICE"
    exit 1
fi

log "PostgreSQL container is running."

# ----------------------------------------------------------
# GENERATE BACKUP FILENAMES
# ----------------------------------------------------------

TIMESTAMP="$(date -u '+%Y%m%dT%H%M%SZ')"

FINAL_FILE="${BACKUP_DIR}/${BACKUP_PREFIX}_${TIMESTAMP}.dump"
FINAL_CHECKSUM="${FINAL_FILE}.sha256"

TEMP_FILE="$(
    mktemp "${BACKUP_DIR}/.${BACKUP_PREFIX}_XXXXXX.tmp"
)"

TEMP_CHECKSUM="${TEMP_FILE}.sha256"

# ----------------------------------------------------------
# CREATE POSTGRESQL BACKUP
# ----------------------------------------------------------

log "Creating PostgreSQL custom-format backup..."

"${COMPOSE[@]}" exec -T "$POSTGRES_SERVICE" sh -ec '
    : "${POSTGRES_USER:?POSTGRES_USER is not configured}"
    : "${POSTGRES_DB:?POSTGRES_DB is not configured}"

    exec pg_dump \
        --username="$POSTGRES_USER" \
        --dbname="$POSTGRES_DB" \
        --format=custom \
        --no-owner \
        --no-acl
' > "$TEMP_FILE"

if [[ ! -s "$TEMP_FILE" ]]; then
    log "ERROR: PostgreSQL backup file is empty."
    exit 1
fi

log "PostgreSQL backup file created successfully."

# ----------------------------------------------------------
# VERIFY BACKUP INTEGRITY
# ----------------------------------------------------------

log "Verifying PostgreSQL backup integrity..."

"${COMPOSE[@]}" exec -T "$POSTGRES_SERVICE" \
    pg_restore --list < "$TEMP_FILE" > /dev/null

log "PostgreSQL backup integrity verified."

# ----------------------------------------------------------
# GENERATE SHA256 CHECKSUM
# ----------------------------------------------------------

log "Generating SHA256 checksum..."

CHECKSUM="$(
    sha256sum "$TEMP_FILE" | awk '{ print $1 }'
)"

printf '%s  %s\n' \
    "$CHECKSUM" \
    "$(basename "$FINAL_FILE")" \
    > "$TEMP_CHECKSUM"

# ----------------------------------------------------------
# APPLY FILE PERMISSIONS
# ----------------------------------------------------------

chmod "$FILE_MODE" "$TEMP_FILE"
chmod "$FILE_MODE" "$TEMP_CHECKSUM"

# ----------------------------------------------------------
# ATOMICALLY MOVE BACKUP FILES
# ----------------------------------------------------------

mv -- "$TEMP_FILE" "$FINAL_FILE"
TEMP_FILE=""

mv -- "$TEMP_CHECKSUM" "$FINAL_CHECKSUM"

log "Backup successfully saved:"
log "$FINAL_FILE"

log "Checksum saved:"
log "$FINAL_CHECKSUM"

# ----------------------------------------------------------
# VERIFY SAVED CHECKSUM
# ----------------------------------------------------------

log "Verifying saved backup checksum..."

(
    cd "$BACKUP_DIR"
    sha256sum --check "$(basename "$FINAL_CHECKSUM")"
)

log "Saved backup checksum verified."

# ----------------------------------------------------------
# BACKUP RETENTION CLEANUP
# ----------------------------------------------------------

log "Removing backups older than ${RETENTION_DAYS} days..."

while IFS= read -r -d '' OLD_BACKUP; do

    log "Removing expired backup: $OLD_BACKUP"

    rm -f -- "$OLD_BACKUP" "${OLD_BACKUP}.sha256"

done < <(
    find "$BACKUP_DIR" \
        -maxdepth 1 \
        -type f \
        -name "${BACKUP_PREFIX}_*.dump" \
        -mtime "+${RETENTION_DAYS}" \
        -print0
)

# ----------------------------------------------------------
# FINISHED
# ----------------------------------------------------------

log "=========================================================="
log "PostgreSQL backup completed successfully."
log "Backup: $FINAL_FILE"
log "=========================================================="

exit 0
